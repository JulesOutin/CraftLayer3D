# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique : "anon" ou "publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : "service_role" ou "secret" (sb_secret_...). JAMAIS côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Secret du endpoint webhook (Developers > Webhooks, ou `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site ---
# En local : http://localhost:3000 ; en prod : https://votre-domaine.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-mails transactionnels (resend.com) ---
# Laisser vide pour désactiver l'envoi (les e-mails sont journalisés dans les logs serveur).
RESEND_API_KEY=
# Doit appartenir à un domaine vérifié sur Resend. onboarding@resend.dev fonctionne
# pour tester sans domaine, mais n'envoie qu'à l'adresse du compte Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Mondial Relay (solutionspro/documentation-technique) ---
# Code enseigne (visible côté navigateur pour le widget Point Relais, ce n'est pas un secret).
# BDTEST pour tester le widget en mode démo.
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=BDTEST
# Clé privée de l'enseigne, réservée à la génération d'étiquettes via l'API WSI2
# (fonctionnalité pas encore branchée). JAMAIS côté client.
MONDIAL_RELAY_PRIVATE_KEY=
